<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3b4d9b3c-2859-48ca-8746-80c7e77f3e82</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

  <!-- The app project sits at the repository root, so its default **/*.cs glob would compile
       the test project's files into the app as well. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AskMyNotes.Tests" />
  </ItemGroup>

</Project>
